# FUJITRACK AI - Environment Configuration Example
# Copy this file to .env and adjust values for local development or production.

# Application
APP_NAME="FUJITRACK AI – Intelligent Tourism Demand Forecasting & Transportation Analytics"
ENVIRONMENT="development"
DEBUG="true"

# Database Configuration
# Local Development: defaults to SQLite fujitrack.db
DATABASE_URL="sqlite:///./fujitrack.db"

# Production PostgreSQL (Neon / Render / Supabase) example:
# DATABASE_URL="postgresql://fujitrack_user:your_password@ep-cool-sample.ap-northeast-1.aws.neon.tech/fujitrack_db?sslmode=require"

# JWT Authentication
JWT_SECRET_KEY="replace-with-a-random-32-byte-hex-string-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# Optional External Meteorological & LLM APIs
WEATHER_API_KEY=""
GEMINI_API_KEY=""
